+// Under Wine, the game does not minimise itself when it loses activation.
+//
+// The game window's procedure (0x00402800) handles WM_ACTIVATEAPP at 0x00402951.
+// On a deactivation in fullscreen (the render window's +0xAC, vtable slot 1) it
+// calls ShowWindow(hwnd, SW_MINIMIZE) at 0x004029DB, then restores the gamma ramp
+// and the desktop's mode (vtable slot 6). On Windows that is how Alt-Tab leaves
+// an exclusive-fullscreen game. Under Wine in a compositor with no taskbar
+// (Proton in Steam's Game Mode, gamescope) nothing restores the window, and Wine
+// shrinks its OpenGL child window to the minimised client rectangle, 160x31: the
+// next SwapBuffers then waited in Mesa's DRI3 back-buffer wait for a buffer the
+// X server never released, on the thread that would have handled the restore.
+// The handoff from the logo movie's window deactivated the game on about one
+// start in three (Bazzite, Proton 11, gamescope).
+//
+// Returning 1 leaves through the consumed exit at 0x004029E1, past the push,
+// push and call, and the gamma and mode restore after it still run. On Windows
+// it returns 0 and the original minimise runs.
+extern "C" int __cdecl KeepWindowOnDeactivateK1()
+{
+    static int underWine = -1;
+    if (underWine < 0) {
+        HMODULE const ntdll = GetModuleHandleA("ntdll.dll");
+        underWine = ntdll && GetProcAddress(ntdll, "wine_get_version") ? 1 : 0;
+    }
+    return underWine;
+}
+
