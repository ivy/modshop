diff --git a/src/controller-native/kotor1.hooks.toml b/src/controller-native/kotor1.hooks.toml
index 78026eb..7bea493 100644
--- a/src/controller-native/kotor1.hooks.toml
+++ b/src/controller-native/kotor1.hooks.toml
@@ -1149,6 +1149,25 @@ exclude_from_restore = []
 source = "esi"
 type = "pointer"
 
+# --- No self-minimise under Wine --------------------------------------------
+#
+# The game window's WM_ACTIVATEAPP case (0x00402951) minimises the window on a
+# deactivation in fullscreen: `mov ecx, [0x007A39D8]; push 6; push ecx; call
+# [ShowWindow]` at 0x004029D2. Under Wine with no taskbar nothing restores it, and
+# the next SwapBuffers can wait forever (K1NativeJoystick.cpp,
+# KeepWindowOnDeactivateK1). The stolen bytes are the hwnd load, an absolute
+# address, nothing to relocate; the consumed exit is the instruction after the
+# call, and EAX is free there (the next use loads it).
+[[hooks]]
+address = 0x004029D2
+type = "detour"
+install = "always"
+function = "KeepWindowOnDeactivateK1"
+original_bytes = [0x8B, 0x0D, 0xD8, 0x39, 0x7A, 0x00]
+skip_original_bytes = false
+consumed_exit_address = 0x004029E1
+exclude_from_restore = ["eax"]
+
