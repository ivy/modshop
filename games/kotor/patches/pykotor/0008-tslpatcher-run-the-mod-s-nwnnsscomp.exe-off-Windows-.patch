         is_windows = os.name == "nt"
+        launcher = shlex.split(os.environ.get(LAUNCHER_ENV, ""))
+        can_run_external = is_windows or bool(launcher)
         nwnnsscomp_exists = bool(self.nwnnsscomp_path and self.nwnnsscomp_path.is_file())
