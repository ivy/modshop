From ad6b22bfa7a9d8efecaa41c0ae249ecb0bd44aa6 Mon Sep 17 00:00:00 2001
From: Ivy Evans <ivy@users.noreply.github.com>
Date: Thu, 15 Oct 2026 00:42:33 -0700
Subject: [PATCH 1/8] tslpatcher: pass ModificationsNSS its replace flag by
 keyword

ModificationsNSS.__init__ takes `replace` keyword-only, so load_compile_list's
positional call raised "ModificationsNSS.__init__() takes 2 positional
arguments but 3 were given" for every mod with a [CompileList] section, and
HoloPatcher refused the mod before patching anything. Seen with Kill the Czerka
Jerk on Kashyyyk, Bastila Has TSL Battle Meditation, Multifire and Autofire,
and Alignment Affects Force Powers from the KOTOR 1 community build.
---
 Libraries/PyKotor/src/pykotor/tslpatcher/reader.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Libraries/PyKotor/src/pykotor/tslpatcher/reader.py b/Libraries/PyKotor/src/pykotor/tslpatcher/reader.py
index ddc7e3683..6b4b3a7ca 100644
--- a/Libraries/PyKotor/src/pykotor/tslpatcher/reader.py
+++ b/Libraries/PyKotor/src/pykotor/tslpatcher/reader.py
@@ -743,7 +743,7 @@ class ConfigReader:
 
         for identifier, file in compilelist_section_dict.items():
             replace: bool = identifier.lower().startswith("replace")
-            modifications = ModificationsNSS(file, replace)
+            modifications = ModificationsNSS(file, replace=replace)
             modifications.destination = default_destination
             modifications.sourcefolder = default_source_folder
 
